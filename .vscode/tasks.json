{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Launch Backend",
            "type": "shell",
            "command": "dotnet run --project ../Voxxy/src/Web.Api",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Launch Web App",
            "type": "shell",
            "command": "ng serve --poll=2500 --host=0.0.0.0",
            "problemMatcher": []
        },
        {
            "label": "Launch All",
            "dependsOn": ["Launch Backend", "Launch Web App"],
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "ng test",
            "problemMatcher": []
        }
    ]
}
